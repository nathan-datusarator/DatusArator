<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 10.0.19041 SDK brings in Windows.Media.SpeechSynthesis for the OneCore voices. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SayMyNewsReally</RootNamespace>
    <AssemblyName>SayMyNewsReally</AssemblyName>
    <Product>Say My News Really</Product>
    <Version>2.0.0</Version>
    <!-- Fluent ThemeMode is flagged experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="System.Speech" Version="9.0.20" />
  </ItemGroup>

</Project>
