<Window x:Class="SayMyNewsReally.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Say My News Really" Height="820" Width="900" MinWidth="560" MinHeight="320"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <DockPanel>
    <!-- Toolbar: wraps onto a second line when the window is narrow. -->
    <WrapPanel DockPanel.Dock="Top" Margin="12,12,12,4" VerticalAlignment="Center">
      <Button x:Name="btnRead" Click="Read_Click" MinWidth="104" Margin="0,0,6,8" ToolTip="Read, pause or resume (F5 or Ctrl+Enter)">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="icoRead" FontFamily="{StaticResource IconFont}" Text="&#xE768;" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="lblRead" Text="Read" />
        </StackPanel>
      </Button>
      <Button x:Name="btnStop" Click="Stop_Click" IsEnabled="False" Margin="0,0,6,8" ToolTip="Stop (Esc). Read again to continue from the highlighted word.">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="Stop" />
        </StackPanel>
      </Button>
      <Button x:Name="btnPaste" Click="Paste_Click" Margin="0,0,6,8" ToolTip="Replace the text with the clipboard">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77F;" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="Paste" />
        </StackPanel>
      </Button>
      <Button x:Name="btnOpen" Click="Open_Click" Margin="0,0,18,8" ToolTip="Open a text or Markdown file (Ctrl+O). You can also drop one on the text.">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="Open" />
        </StackPanel>
      </Button>

      <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
        <TextBlock Text="Voice" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="cmbVoice" Width="230" DisplayMemberPath="Label" MaxDropDownHeight="480" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
        <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Slider x:Name="sldRate" Width="130" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                VerticalAlignment="Center" ValueChanged="Rate_ValueChanged" />
        <TextBlock x:Name="lblRate" Width="28" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
        <TextBlock Text="Text is" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="cmbMode" Width="140" DisplayMemberPath="Label" SelectionChanged="Mode_SelectionChanged" />
      </StackPanel>
      <CheckBox x:Name="chkReadCode" Content="Read code blocks" VerticalAlignment="Center" Margin="0,0,0,8"
                ToolTip="Off: code blocks are announced and skipped. On: code is read line by line." />
    </WrapPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="14,4,14,10">
      <TextBlock x:Name="lblKind" DockPanel.Dock="Right" Opacity="0.7" />
      <TextBlock x:Name="lblStatus" Opacity="0.7" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <Grid Margin="12,4,12,4">
      <TextBox x:Name="txtMain" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" FontSize="15" Padding="10,8"
               VerticalContentAlignment="Top" IsInactiveSelectionHighlightEnabled="True"
               TextChanged="Text_TextChanged" PreviewDragOver="Text_PreviewDragOver" PreviewDrop="Text_PreviewDrop" />
      <TextBlock x:Name="lblPlaceholder" IsHitTestVisible="False" Margin="22,18" FontSize="15" Opacity="0.5" TextWrapping="Wrap"
                 Text="Paste text or drop a .md / .txt file here, then press Read. Markdown is read the way it looks, not the way it is typed." />
    </Grid>
  </DockPanel>
</Window>
